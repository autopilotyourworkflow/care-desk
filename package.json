{
  "name": "care-desk",
  "version": "0.1.0",
  "private": true,
  "description": "Care Desk: a safety-first patient-support copilot. Unofficial concept for Dispensed by Chanon Poovaviranon (Beam). All data is fictional.",
  "scripts": {
    "predev": "tsx scripts/build-public-data.ts",
    "dev": "next dev",
    "prebuild": "tsx scripts/build-public-data.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "data:public": "tsx scripts/build-public-data.ts",
    "precompute": "tsx scripts/precompute.ts",
    "eval": "tsx scripts/eval.ts",
    "validate:data": "tsx scripts/validate-data.ts",
    "worker:dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.1",
    "next": "^16.2.9",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260923.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1",
    "wrangler": "^4.136.3"
  }
}
